{
  "rules_version": "2026.11.1",
  "description": "Grading rules for crypto-inventory. Edit this file (or pass --rules your.json) to change how algorithms are graded: no code changes needed. That is crypto-agility applied to the scanner itself.",

  "algorithms": {
    "MD5": {"name": "MD5", "grade": "BROKEN", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Collisions (two inputs with the same hash) can be made in seconds on a laptop.",
      "fix": "Use SHA-256 or SHA-3 for integrity; Argon2id, scrypt or bcrypt for passwords."},
    "SHA1": {"name": "SHA-1", "grade": "BROKEN", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Practical collisions since 2017 (the SHAttered attack); browsers and CAs dropped it.",
      "fix": "Use SHA-256, SHA-384 or SHA-3."},
    "SHA224": {"name": "SHA-224", "grade": "LEGACY", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Only 112-bit collision resistance, below the 128-bit level modern guidance expects.",
      "fix": "Use SHA-256 or stronger."},
    "SHA256": {"name": "SHA-256", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Standard, well-studied hash. Grover's algorithm only halves its strength, which still leaves plenty.",
      "fix": ""},
    "SHA384": {"name": "SHA-384", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "SHA-2 family hash with a large safety margin, including against quantum attacks.",
      "fix": ""},
    "SHA512": {"name": "SHA-512", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "SHA-2 family hash with a large safety margin, including against quantum attacks.",
      "fix": ""},
    "SHA512T": {"name": "SHA-512/t (SHA-512/224, SHA-512/256)", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Truncated SHA-512 variants; sound designs.",
      "fix": ""},
    "SHA3": {"name": "SHA-3 / SHAKE", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "The newer NIST hash standard (FIPS 202), built differently from SHA-2 as a backup.",
      "fix": ""},
    "BLAKE2": {"name": "BLAKE2", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Fast, modern hash with no known weaknesses.",
      "fix": ""},
    "BLAKE3": {"name": "BLAKE3", "grade": "CURRENT", "primitive": "hash", "quantum_vulnerable": false, "fast_hash": true,
      "why": "Very fast, modern hash with no known weaknesses.",
      "fix": ""},
    "UNSALTED_PASSWORD_HASH": {"name": "Password stored with a fast, unsalted hash", "grade": "BROKEN", "primitive": "hash", "quantum_vulnerable": false,
      "why": "General-purpose hashes are built to be fast, so GPUs try billions of password guesses per second, and with no salt, precomputed tables crack common passwords instantly.",
      "fix": "Use a password hash: Argon2id (best), scrypt or bcrypt, each with a random salt."},

    "DES": {"name": "DES", "grade": "BROKEN", "primitive": "block-cipher", "quantum_vulnerable": false,
      "why": "56-bit key: brute-forced in under a day since the late 1990s.",
      "fix": "Use AES-256-GCM or ChaCha20-Poly1305."},
    "TDES": {"name": "3DES (Triple DES)", "grade": "LEGACY", "primitive": "block-cipher", "quantum_vulnerable": false,
      "why": "64-bit blocks leak data after large volumes (Sweet32), and NIST withdrew it for new encryption.",
      "fix": "Use AES-256-GCM or ChaCha20-Poly1305."},
    "RC4": {"name": "RC4", "grade": "BROKEN", "primitive": "stream-cipher", "quantum_vulnerable": false,
      "why": "Biased keystream; banned from TLS by RFC 7465.",
      "fix": "Use AES-256-GCM or ChaCha20-Poly1305."},
    "OLD_BLOCK": {"name": "Old cipher (Blowfish / CAST5 / IDEA / RC2)", "grade": "LEGACY", "primitive": "block-cipher", "quantum_vulnerable": false,
      "why": "Older ciphers with small 64-bit blocks or weak keys; kept only for reading old data.",
      "fix": "Use AES-256-GCM or ChaCha20-Poly1305."},
    "AES": {"name": "AES", "grade": "CURRENT", "primitive": "block-cipher", "quantum_vulnerable": false,
      "why": "The standard block cipher. Grover's algorithm halves key strength, so AES-256 stays very safe. Pair it with an authenticated mode such as GCM.",
      "fix": ""},
    "ECB": {"name": "ECB mode", "grade": "BROKEN", "primitive": "block-cipher", "mode": "ecb", "quantum_vulnerable": false,
      "why": "Encrypts identical blocks to identical output, so patterns show through (the famous 'ECB penguin').",
      "fix": "Use AES-GCM (or ChaCha20-Poly1305)."},
    "CBC": {"name": "CBC mode", "grade": "LEGACY", "primitive": "block-cipher", "mode": "cbc", "quantum_vulnerable": false,
      "why": "Hides data but doesn't detect tampering; without a separate MAC it's open to padding-oracle attacks.",
      "fix": "Use an authenticated mode: AES-GCM or ChaCha20-Poly1305."},
    "UNAUTH_MODE": {"name": "Unauthenticated mode (CTR / CFB / OFB)", "grade": "LEGACY", "primitive": "block-cipher", "mode": "other", "quantum_vulnerable": false,
      "why": "Encrypts but can't tell if someone flipped bits in the ciphertext.",
      "fix": "Use an authenticated mode: AES-GCM or ChaCha20-Poly1305."},
    "AES_GCM": {"name": "AES-GCM", "grade": "CURRENT", "primitive": "ae", "mode": "gcm", "quantum_vulnerable": false,
      "why": "Authenticated encryption: keeps data secret and detects tampering. Never reuse a nonce with the same key.",
      "fix": ""},
    "AES_AEAD_OTHER": {"name": "AES authenticated mode (CCM / OCB3 / SIV / GCM-SIV / EAX)", "grade": "CURRENT", "primitive": "ae", "quantum_vulnerable": false,
      "why": "Authenticated encryption built on AES.",
      "fix": ""},
    "CHACHA20_POLY1305": {"name": "ChaCha20-Poly1305", "grade": "CURRENT", "primitive": "ae", "quantum_vulnerable": false,
      "why": "Authenticated encryption that's fast even without AES hardware support.",
      "fix": ""},
    "CHACHA20": {"name": "ChaCha20 (without Poly1305)", "grade": "LEGACY", "primitive": "stream-cipher", "quantum_vulnerable": false,
      "why": "A good cipher, but on its own it doesn't detect tampering.",
      "fix": "Use ChaCha20-Poly1305 (authenticated)."},

    "HMAC": {"name": "HMAC", "grade": "CURRENT", "primitive": "mac", "quantum_vulnerable": false,
      "why": "Keyed fingerprint that proves a message wasn't changed. Current when built on SHA-256 or stronger.",
      "fix": ""},
    "HMAC_SHA1": {"name": "HMAC-SHA1", "grade": "LEGACY", "primitive": "mac", "quantum_vulnerable": false,
      "why": "Not practically forgeable today (HMAC survives SHA-1's collision problem), but it's built on a retired hash.",
      "fix": "Use HMAC-SHA-256 or HMAC-SHA-384."},
    "HMAC_MD5": {"name": "HMAC-MD5", "grade": "LEGACY", "primitive": "mac", "quantum_vulnerable": false,
      "why": "Not practically forgeable today, but MD5 is disallowed by modern standards.",
      "fix": "Use HMAC-SHA-256 or HMAC-SHA-384."},
    "CMAC": {"name": "CMAC", "grade": "CURRENT", "primitive": "mac", "quantum_vulnerable": false,
      "why": "AES-based message authentication code.",
      "fix": ""},
    "POLY1305": {"name": "Poly1305", "grade": "CURRENT", "primitive": "mac", "quantum_vulnerable": false,
      "why": "One-time message authenticator (the authentication half of ChaCha20-Poly1305).",
      "fix": ""},

    "HKDF": {"name": "HKDF", "grade": "CURRENT", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "Turns a shared secret into one or more strong keys.",
      "fix": ""},
    "PBKDF2": {"name": "PBKDF2 (low or unknown iteration count)", "grade": "LEGACY", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "Only as strong as its iteration count. Below 600,000 (OWASP's minimum for SHA-256) it's cheap to brute-force with GPUs. If no count is shown, the scanner couldn't read it, so check it by hand.",
      "fix": "Raise iterations to 600,000 or more, or switch to Argon2id or scrypt."},
    "PBKDF2_STRONG": {"name": "PBKDF2 (600,000+ iterations)", "grade": "CURRENT", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "PBKDF2 with a high enough iteration count. Memory-hard options (Argon2id, scrypt) resist GPUs better.",
      "fix": ""},
    "SCRYPT": {"name": "scrypt", "grade": "CURRENT", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "Slow, memory-hungry password hashing that resists GPU cracking.",
      "fix": ""},
    "BCRYPT": {"name": "bcrypt", "grade": "CURRENT", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "Slow password hashing with a built-in salt.",
      "fix": ""},
    "ARGON2": {"name": "Argon2id", "grade": "CURRENT", "primitive": "kdf", "quantum_vulnerable": false,
      "why": "Winner of the Password Hashing Competition; the top choice for new password storage.",
      "fix": ""},

    "RSA": {"name": "RSA", "grade": "LEGACY", "primitive": "pke", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Safe against today's computers at 2048+ bits, but Shor's algorithm on a quantum computer breaks it. Data encrypted today can be recorded and decrypted later (harvest now, decrypt later).",
      "fix": "Plan a move to ML-KEM (encryption/key exchange) or ML-DSA (signatures), usually as a hybrid first."},
    "RSA_WEAK": {"name": "RSA under 2048 bits", "grade": "BROKEN", "primitive": "pke", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Keys this small (e.g. RSA-1024) are within reach of well-funded attackers today.",
      "fix": "Use at least RSA-3072 now, and plan the move to ML-KEM / ML-DSA."},
    "DSA": {"name": "DSA", "grade": "LEGACY", "primitive": "signature", "quantum_vulnerable": true, "pq_partner": "MLDSA",
      "why": "Retired from new signatures in FIPS 186-5, and broken by Shor's algorithm.",
      "fix": "Use ML-DSA (or a hybrid of Ed25519 + ML-DSA)."},
    "DSA_WEAK": {"name": "DSA under 2048 bits", "grade": "BROKEN", "primitive": "signature", "quantum_vulnerable": true, "pq_partner": "MLDSA",
      "why": "1024-bit DSA is too small to be safe today.",
      "fix": "Use ML-DSA (or a hybrid of Ed25519 + ML-DSA)."},
    "DH": {"name": "Diffie-Hellman (finite field)", "grade": "LEGACY", "primitive": "key-agree", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Fine today at 2048+ bits, but broken by Shor's algorithm; recorded traffic can be decrypted later.",
      "fix": "Move to hybrid key exchange: X25519 + ML-KEM."},
    "DH_WEAK": {"name": "Diffie-Hellman under 2048 bits", "grade": "BROKEN", "primitive": "key-agree", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Small DH groups fall to precomputation attacks (Logjam).",
      "fix": "Move to hybrid key exchange: X25519 + ML-KEM."},
    "ECC": {"name": "Elliptic-curve keys (ECDSA)", "grade": "LEGACY", "primitive": "signature", "quantum_vulnerable": true, "pq_partner": "MLDSA",
      "why": "Strong today, but Shor's algorithm breaks elliptic curves too.",
      "fix": "Plan a move to ML-DSA, usually as a hybrid first."},
    "ECDH": {"name": "ECDH key exchange", "grade": "LEGACY", "primitive": "key-agree", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Strong today, but broken by Shor's algorithm; recorded traffic can be decrypted later.",
      "fix": "Move to hybrid key exchange: X25519 + ML-KEM."},
    "ED25519": {"name": "Ed25519", "grade": "LEGACY", "primitive": "signature", "quantum_vulnerable": true, "pq_partner": "MLDSA",
      "why": "Excellent classical signature, but Shor's algorithm breaks it.",
      "fix": "Pair it with ML-DSA in a hybrid signature, then move to ML-DSA."},
    "ED448": {"name": "Ed448", "grade": "LEGACY", "primitive": "signature", "quantum_vulnerable": true, "pq_partner": "MLDSA",
      "why": "Strong classical signature, but Shor's algorithm breaks it.",
      "fix": "Pair it with ML-DSA in a hybrid signature, then move to ML-DSA."},
    "X25519": {"name": "X25519", "grade": "LEGACY", "primitive": "key-agree", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Excellent classical key exchange, but Shor's algorithm breaks it; recorded traffic can be decrypted later.",
      "fix": "Pair it with ML-KEM in a hybrid (like TLS's X25519MLKEM768)."},
    "X448": {"name": "X448", "grade": "LEGACY", "primitive": "key-agree", "quantum_vulnerable": true, "pq_partner": "MLKEM",
      "why": "Strong classical key exchange, but Shor's algorithm breaks it.",
      "fix": "Pair it with ML-KEM in a hybrid."},
    "MLKEM": {"name": "ML-KEM (FIPS 203)", "grade": "CURRENT", "primitive": "kem", "quantum_vulnerable": false,
      "why": "NIST's post-quantum key encapsulation standard, built on lattice math that Shor's algorithm doesn't break.",
      "fix": ""},
    "MLDSA": {"name": "ML-DSA (FIPS 204)", "grade": "CURRENT", "primitive": "signature", "quantum_vulnerable": false,
      "why": "NIST's main post-quantum signature standard.",
      "fix": ""},
    "SLHDSA": {"name": "SLH-DSA (FIPS 205)", "grade": "CURRENT", "primitive": "signature", "quantum_vulnerable": false,
      "why": "Hash-based post-quantum signature: big signatures, very conservative security.",
      "fix": ""},

    "INSECURE_RANDOM": {"name": "random module used for a secret", "grade": "BROKEN", "primitive": "drbg", "quantum_vulnerable": false,
      "why": "Python's random module (Mersenne Twister) is predictable: after seeing 624 outputs, an attacker can predict every future value.",
      "fix": "Use the secrets module (secrets.token_hex, secrets.choice) or os.urandom."},
    "CSPRNG": {"name": "OS secure random (CSPRNG)", "grade": "CURRENT", "primitive": "drbg", "quantum_vulnerable": false,
      "why": "Unpredictable randomness from the operating system, suitable for keys, tokens and nonces.",
      "fix": ""},

    "TLS_OLD": {"name": "Old SSL/TLS version (SSL 2/3, TLS 1.0/1.1)", "grade": "BROKEN", "primitive": "protocol", "quantum_vulnerable": false,
      "why": "Deprecated by RFC 8996; known attacks such as POODLE and BEAST.",
      "fix": "Require TLS 1.2 or later (TLS 1.3 preferred)."},
    "TLS_NO_VERIFY": {"name": "TLS certificate checking turned off", "grade": "BROKEN", "primitive": "protocol", "quantum_vulnerable": false,
      "why": "Without certificate checks, anyone in the middle of the connection can pretend to be the server.",
      "fix": "Leave verification on (the default). For a private CA, point verify= / cafile= at its certificate instead."},
    "TLS_MODERN": {"name": "TLS 1.2+ / secure default context", "grade": "CURRENT", "primitive": "protocol", "quantum_vulnerable": false,
      "why": "Modern TLS settings. Note: the key exchange is only quantum-safe if a hybrid group such as X25519MLKEM768 is negotiated (OpenSSL 3.5+).",
      "fix": ""},

    "JWT_NONE": {"name": "JWT with algorithm 'none' (unsigned)", "grade": "BROKEN", "primitive": "signature", "quantum_vulnerable": false,
      "why": "A JSON Web Token with alg 'none' carries no signature, so anyone can write their own token and the server will accept it.",
      "fix": "Sign tokens (e.g. ES256, EdDSA or HS256 with a strong secret) and pass an explicit algorithms list when verifying."},

    "PLAINTEXT_PRIVATE_KEY": {"name": "Unencrypted private key stored in the code base", "grade": "BROKEN", "primitive": "other", "quantum_vulnerable": false,
      "why": "Anyone who can read the repository, or any copy or old commit of it, holds this key and can impersonate its owner or decrypt what it protects.",
      "fix": "Remove the file, treat the key as leaked and replace it (it stays in git history), and keep keys in a secrets manager or vault."}
  },

  "hash_names": {
    "md5": "MD5", "sha1": "SHA1", "sha224": "SHA224", "sha256": "SHA256", "sha384": "SHA384", "sha512": "SHA512",
    "sha512_224": "SHA512T", "sha512_256": "SHA512T",
    "sha3_224": "SHA3", "sha3_256": "SHA3", "sha3_384": "SHA3", "sha3_512": "SHA3", "shake_128": "SHA3", "shake_256": "SHA3",
    "blake2b": "BLAKE2", "blake2s": "BLAKE2"
  },

  "detectors": [
    {"match": "hashlib.md5", "algorithm": "MD5"},
    {"match": "hashlib.sha1", "algorithm": "SHA1"},
    {"match": "hashlib.sha224", "algorithm": "SHA224"},
    {"match": "hashlib.sha256", "algorithm": "SHA256"},
    {"match": "hashlib.sha384", "algorithm": "SHA384"},
    {"match": "hashlib.sha512", "algorithm": "SHA512"},
    {"match": "hashlib.sha3_224", "algorithm": "SHA3"},
    {"match": "hashlib.sha3_256", "algorithm": "SHA3"},
    {"match": "hashlib.sha3_384", "algorithm": "SHA3"},
    {"match": "hashlib.sha3_512", "algorithm": "SHA3"},
    {"match": "hashlib.shake_128", "algorithm": "SHA3"},
    {"match": "hashlib.shake_256", "algorithm": "SHA3"},
    {"match": "hashlib.blake2b", "algorithm": "BLAKE2"},
    {"match": "hashlib.blake2s", "algorithm": "BLAKE2"},
    {"match": "hashlib.scrypt", "algorithm": "SCRYPT"},
    {"match": "hashlib.pbkdf2_hmac", "algorithm": "PBKDF2", "calls_only": true,
      "threshold": {"keyword": "iterations", "position": 3, "min": 600000, "below": "PBKDF2", "otherwise": "PBKDF2_STRONG"},
      "hash_arg": {"keyword": "hash_name", "position": 0}},
    {"match": "blake3", "algorithm": "BLAKE3"},

    {"match": "cryptography.hazmat.primitives.hashes.MD5", "algorithm": "MD5"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA1", "algorithm": "SHA1"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA224", "algorithm": "SHA224"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA256", "algorithm": "SHA256"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA384", "algorithm": "SHA384"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA512", "algorithm": "SHA512"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA512_224", "algorithm": "SHA512T"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA512_256", "algorithm": "SHA512T"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA3_224", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA3_256", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA3_384", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.SHA3_512", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.SHAKE128", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.SHAKE256", "algorithm": "SHA3"},
    {"match": "cryptography.hazmat.primitives.hashes.BLAKE2b", "algorithm": "BLAKE2"},
    {"match": "cryptography.hazmat.primitives.hashes.BLAKE2s", "algorithm": "BLAKE2"},

    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.AES", "algorithm": "AES"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.AES128", "algorithm": "AES"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.AES256", "algorithm": "AES"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.ChaCha20", "algorithm": "CHACHA20"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.TripleDES", "algorithm": "TDES"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.ARC4", "algorithm": "RC4"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.Blowfish", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.CAST5", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.primitives.ciphers.algorithms.IDEA", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.TripleDES", "algorithm": "TDES"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.ARC4", "algorithm": "RC4"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.Blowfish", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.CAST5", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.IDEA", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.decrepit.ciphers.algorithms.RC2", "algorithm": "OLD_BLOCK"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.ECB", "algorithm": "ECB"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.CBC", "algorithm": "CBC"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.CTR", "algorithm": "UNAUTH_MODE"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.CFB", "algorithm": "UNAUTH_MODE"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.CFB8", "algorithm": "UNAUTH_MODE"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.OFB", "algorithm": "UNAUTH_MODE"},
    {"match": "cryptography.hazmat.primitives.ciphers.modes.GCM", "algorithm": "AES_GCM"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.AESGCM", "algorithm": "AES_GCM"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.AESCCM", "algorithm": "AES_AEAD_OTHER"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.AESOCB3", "algorithm": "AES_AEAD_OTHER"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.AESSIV", "algorithm": "AES_AEAD_OTHER"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.AESGCMSIV", "algorithm": "AES_AEAD_OTHER"},
    {"match": "cryptography.hazmat.primitives.ciphers.aead.ChaCha20Poly1305", "algorithm": "CHACHA20_POLY1305"},

    {"match": "*.MODE_ECB", "algorithm": "ECB"},
    {"match": "*.MODE_CBC", "algorithm": "CBC"},
    {"match": "*.MODE_CTR", "algorithm": "UNAUTH_MODE"},
    {"match": "*.MODE_CFB", "algorithm": "UNAUTH_MODE"},
    {"match": "*.MODE_OFB", "algorithm": "UNAUTH_MODE"},
    {"match": "*.MODE_GCM", "algorithm": "AES_GCM"},
    {"match": "*.MODE_CCM", "algorithm": "AES_AEAD_OTHER"},
    {"match": "*.MODE_EAX", "algorithm": "AES_AEAD_OTHER"},
    {"match": "*.MODE_OCB", "algorithm": "AES_AEAD_OTHER"},
    {"match": "*.MODE_SIV", "algorithm": "AES_AEAD_OTHER"},

    {"match": "hmac.new", "algorithm": "HMAC",
      "hash_arg": {"keyword": "digestmod", "position": 2, "variants": {"SHA1": "HMAC_SHA1", "MD5": "HMAC_MD5"}}},
    {"match": "hmac.HMAC", "algorithm": "HMAC",
      "hash_arg": {"keyword": "digestmod", "position": 2, "variants": {"SHA1": "HMAC_SHA1", "MD5": "HMAC_MD5"}}},
    {"match": "hmac.digest", "algorithm": "HMAC",
      "hash_arg": {"keyword": "digest", "position": 2, "variants": {"SHA1": "HMAC_SHA1", "MD5": "HMAC_MD5"}}},
    {"match": "cryptography.hazmat.primitives.hmac.HMAC", "algorithm": "HMAC",
      "hash_arg": {"keyword": "algorithm", "position": 1, "variants": {"SHA1": "HMAC_SHA1", "MD5": "HMAC_MD5"}}},
    {"match": "cryptography.hazmat.primitives.cmac", "algorithm": "CMAC"},
    {"match": "cryptography.hazmat.primitives.poly1305", "algorithm": "POLY1305"},

    {"match": "cryptography.hazmat.primitives.kdf.hkdf", "algorithm": "HKDF",
      "hash_arg": {"keyword": "algorithm", "position": 0}},
    {"match": "cryptography.hazmat.primitives.kdf.pbkdf2", "algorithm": "PBKDF2", "calls_only": true,
      "threshold": {"call": "PBKDF2HMAC", "keyword": "iterations", "position": 3, "min": 600000, "below": "PBKDF2", "otherwise": "PBKDF2_STRONG"},
      "hash_arg": {"call": "PBKDF2HMAC", "keyword": "algorithm", "position": 0}},
